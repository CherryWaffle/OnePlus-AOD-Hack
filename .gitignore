# Settings snapshots from backup.ps1. They hold the phone's own settings
# (device name, Wi-Fi/Bluetooth related values, ...), so never commit them.
backups/

# App build output and the local signing key (keep the key, never publish it).
app/build/
app/keystore/

# Google's SDK Platform-Tools, if unzipped into the project (users download it themselves).
platform-tools/
