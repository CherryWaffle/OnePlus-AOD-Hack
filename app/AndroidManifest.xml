<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aodhack.keepon"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />

    <!-- Granted once over ADB (see README): lets the app run dumpsys itself. -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exact alarms for the schedule's start and end times. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:label="AOD Keep-On"
        android:icon="@android:drawable/ic_lock_idle_lock"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Direct-boot aware so AOD comes back before the first unlock after a restart.
             Also receives the schedule alarm (explicit intent) and clock/time-zone changes. -->
        <receiver
            android:name=".ApplyReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
